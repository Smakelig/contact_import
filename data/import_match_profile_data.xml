<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="import_match_profile_contacts" model="import.match.profile">
        <field name="name">Contacts</field>
        <field name="target_model_id" ref="base.model_res_partner"/>
    </record>

    <record id="import_match_rule_contacts_email" model="import.match.rule">
        <field name="profile_id" ref="import_match_profile_contacts"/>
        <field name="field_name">email</field>
        <field name="match_method">exact</field>
        <field name="weight">3.0</field>
        <field name="sequence">10</field>
    </record>

    <record id="import_match_rule_contacts_phone" model="import.match.rule">
        <field name="profile_id" ref="import_match_profile_contacts"/>
        <field name="field_name">phone</field>
        <field name="match_method">phone_normalized</field>
        <field name="weight">2.0</field>
        <field name="sequence">20</field>
    </record>

    <record id="import_match_rule_contacts_mobile" model="import.match.rule">
        <field name="profile_id" ref="import_match_profile_contacts"/>
        <field name="field_name">mobile</field>
        <field name="match_method">phone_normalized</field>
        <field name="weight">2.0</field>
        <field name="sequence">21</field>
    </record>

    <record id="import_match_rule_contacts_name" model="import.match.rule">
        <field name="profile_id" ref="import_match_profile_contacts"/>
        <field name="field_name">name</field>
        <field name="match_method">trigram</field>
        <field name="weight">1.0</field>
        <field name="sequence">30</field>
    </record>
</odoo>

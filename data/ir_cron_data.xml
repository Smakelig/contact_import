<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Processes CSV batches queued by contact.import.csv.wizard in the
        background, in bounded chunks - see import.batch's
        _cron_process_pending_imports/_process_pending_chunk.

        Normal case: the wizard calls this cron's _trigger() right after
        queuing a batch, so this runs almost immediately (a database
        NOTIFY wakes a cron worker - see ir.cron._trigger's own
        docstring), not on the interval below. If it still has work left
        when its per-call row budget runs out, it re-triggers itself, so
        a large file gets processed as a short chain of near-back-to-back
        runs rather than waiting on this interval repeatedly.

        The interval_number/interval_type below is only a SAFETY NET for
        the rare case a trigger chain is ever broken (e.g. the server
        restarts mid-processing, right after a chunk commits but before
        the next _trigger() call happens) - without this, a batch stuck
        in 'processing' with pending_rows_json still set would otherwise
        sit untouched until someone noticed.
    -->
    <record id="ir_cron_process_import_batches" model="ir.cron">
        <field name="name">Contact Import: process queued CSV batches</field>
        <field name="model_id" ref="model_import_batch"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_imports()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>

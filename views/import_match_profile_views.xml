<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_import_match_profile_list" model="ir.ui.view">
        <field name="name">import.match.profile.list</field>
        <field name="model">import.match.profile</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false">
                <field name="name"/>
                <field name="target_model_name"/>
            </tree>
        </field>
    </record>

    <record id="view_import_match_profile_form" model="ir.ui.view">
        <field name="name">import.match.profile.form</field>
        <field name="model">import.match.profile</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="target_model_id"/>
                    </group>
                    <field name="rule_ids">
                        <tree create="false" delete="false" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="field_name"/>
                            <field name="match_method"/>
                            <field name="weight"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_import_match_profile" model="ir.actions.act_window">
        <field name="name">Matching Profiles</field>
        <field name="res_model">import.match.profile</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_import_match_profile" name="Matching Profiles" parent="menu_contact_import_root"
              action="action_import_match_profile" sequence="30" groups="base.group_no_one"/>
</odoo>
